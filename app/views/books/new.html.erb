<% content_for :title, "Add a book" %>

<div class="wrap wrap--narrow">
  <div class="page-head">
    <h1>Add a book</h1>
  </div>

  <%= form_with model: @book, class: "stack" do |form| %>
    <% if @book.errors.any? %>
      <div class="flash flash--alert">
        <%= @book.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="field">
      <%= form.label :file, "PDF", class: "field__label" %>
      <%= form.file_field :file, accept: "application/pdf" %>
      <p class="small muted" style="margin-top: 0.4rem;">
        The PDF needs a real text layer, which most non-scanned books have.
        Processing a full novel takes about a minute.
      </p>
    </div>

    <div class="field">
      <%= form.label :title, "Title (optional)", class: "field__label" %>
      <%= form.text_field :title, placeholder: "Taken from the file if left blank" %>
    </div>

    <div class="row">
      <%= form.submit "Upload", class: "btn btn--primary" %>
      <%= link_to "Cancel", root_path, class: "btn btn--quiet" %>
    </div>
  <% end %>
</div>
