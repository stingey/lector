<%# Every kind of text block gets word spans, headings included: a chapter title is
    still Spanish you might not know, and it means a misclassified block stays
    fully usable rather than becoming dead text. %>
<% renderer = BlockRenderer.new(block, lemma_texts: lemma_texts,
                                       statuses_by_lemma: statuses_by_lemma,
                                       bookmarked_positions: bookmarked_positions) %>
<% case block.kind
   when "image" %>
  <% if block.book_image&.file&.attached? %>
    <figure class="reader__figure">
      <%= image_tag block.book_image.file, alt: "", loading: "lazy" %>
    </figure>
  <% end %>
<% when "heading" %>
  <h2 class="reader__heading"><%= renderer.to_html %></h2>
<% else %>
  <p><%= renderer.to_html %></p>
<% end %>
