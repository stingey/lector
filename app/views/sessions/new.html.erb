<% content_for :title, "Sign in" %>

<%= render layout: "shared/auth",
           locals: {
             title: "Sign in",
             subtitle: "Read Spanish books and build a word bank as you go.",
             footer: capture { concat "New here? "; concat link_to("Create an account", new_registration_path) }
           } do %>
  <%= form_with url: session_path, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email", class: "field__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
                           autocomplete: "username", value: params[:email_address] %>
    </div>

    <div class="field">
      <%= form.label :password, "Password", class: "field__label" %>
      <%= form.password_field :password, required: true,
                              autocomplete: "current-password", maxlength: User::MAX_PASSWORD_LENGTH %>
    </div>

    <%= form.submit "Sign in", class: "btn btn--primary btn--block" %>
  <% end %>

  <div class="auth__aside">
    <%= link_to "Forgot your password?", new_password_path %>
  </div>
<% end %>
